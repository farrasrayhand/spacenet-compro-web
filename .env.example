# Panel admin SpaceNet
# Salin file ini menjadi .env.local lalu isi nilainya.
ADMIN_PASSWORD=ganti-dengan-sandi-kuat
# Minimal 32 karakter acak. Contoh membuat: openssl rand -hex 32
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Notifikasi pendaftaran baru (opsional; isi salah satu atau keduanya)
# Webhook JSON generik (n8n, Make, Zapier). URL Discord juga didukung.
NOTIFY_WEBHOOK_URL=

# Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SpaceNet <no-reply@example.com>
NOTIFY_TO=

# Opsional: lokasi file SQLite (default ./data/spacenet.db)
# DB_PATH=/var/lib/spacenet/spacenet.db
